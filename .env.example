# Copy to .env and fill in. .env is ignored by git; never commit a key.
# Values already set in the environment win over this file.

# Needed only to generate levels (generator/wiki_level.py, generator/generate_level.py --openai).
OPENAI_API_KEY=

# Model for the level generators. Leave out for the default.
# OPENAI_MODEL=gpt-5.5

# The game's folder. Leave out if the game is in a Steam library; it is found through Steam.
# BET_GAME_DIR=D:\SteamLibrary\steamapps\common\Backrooms_Escape_Together
